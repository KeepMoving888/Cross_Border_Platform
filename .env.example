# 环境配置(开发环境)
APP_ENV=development
APP_PORT=8080
APP_NAME=cb-platform

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cb
MYSQL_PASSWORD=cb_pass_2026
MYSQL_DB=cb_platform

# PostgreSQL (向量库)
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=cb
PG_PASSWORD=cb_pass_2026
PG_DB=cb_vector
PG_SSLMODE=disable

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=cb_platform_jwt_secret_change_in_production
JWT_EXPIRE_HOURS=24

# LLM Provider (llm | glm | deepseek | qwen)
LLM_PROVIDER=glm
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-plus

# Asynq
ASYNQ_CONCURRENCY=10

# Log
LOG_LEVEL=info
LOG_DIR=logs
